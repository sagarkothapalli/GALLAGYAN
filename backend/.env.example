# GallaGyan Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# JWT Secret Key — MUST be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-hex-secret-key-here

# Comma-separated list of allowed CORS origins (never use * in production)
ALLOWED_ORIGINS=https://gallagyan.xyz,https://www.gallagyan.xyz,http://localhost:3000

# Default user passcode (used only on first DB init — change immediately after)
# Must be at least 8 characters.
DEFAULT_USER_PASSCODE=changeme_on_first_run

# Environment: "production" or "development" — controls cookie Secure flag
ENVIRONMENT=production

# Cookie domain (optional): set to ".gallagyan.xyz" for cross-subdomain cookies
# COOKIE_DOMAIN=.gallagyan.xyz

# SteadyStack specific
RESEND_API_KEY=your_resend_api_key
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token
FROM_EMAIL=hello@steadystack.com
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/steadystack
